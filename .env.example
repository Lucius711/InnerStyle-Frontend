# Origin of the InnerStyle backend API. Leave blank in dev to use the Vite proxy
# (which forwards /api -> http://localhost:2207). Set this for production builds.
VITE_API_BASE_URL=

# Optional: override the dev proxy target (defaults to http://localhost:2207)
VITE_API_PROXY_TARGET=http://localhost:2207

# Google sign-in now runs entirely server-side (see InnerStyle-Backend .env
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI) — no client id needed here.

# Google Maps (address picker on the shipping form). Leave blank to disable the map
# (the form still works). https://console.cloud.google.com → enable "Maps JavaScript API"
# and "Places API", then create an API key restricted to your domains.
VITE_GOOGLE_MAPS_API_KEY=

# Address search on the shipping map (full Vietnamese coverage, like Google Maps, free tier).
# The map tiles themselves are free OpenStreetMap and need NO key — this key only powers the
# address autocomplete/geocoding. Leave blank to fall back to OSM Nominatim (sparser in VN).
# Get a REST API key at https://account.goong.io (Goong) → API Keys.
VITE_GOONG_API_KEY=

# Goong Maptiles key (map DISPLAY). Different from the REST key above. When set, the shipping map
# shows Goong's Vietnamese tiles; leave blank to use free OpenStreetMap tiles instead.
# Get a Maptiles key at https://account.goong.io → API Keys (Maptiles).
VITE_GOONG_MAPTILES_KEY=
